# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173
PUBLIC_ORIGIN=http://127.0.0.1:8080
LOG_LEVEL=info
# false sans proxy, 1 derrière Nginx Docker seul, 2 derrière un reverse proxy HTTPS puis Nginx.
# N’utilisez jamais une valeur supérieure au nombre de proxies que vous contrôlez.
TRUST_PROXY=false

# PostgreSQL
POSTGRES_DB=songfest
POSTGRES_USER=songfest
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433
DATABASE_URL=postgresql://songfest:replace-with-a-long-random-password@localhost:5432/songfest

# Published ports
DB_BIND_ADDRESS=127.0.0.1
DB_TEST_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1
WEB_BIND_ADDRESS=127.0.0.1
API_PORT=3000
WEB_PORT=8080

# Mission 3
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Facultatif : permet de créer un premier compte via `npm run db:seed`.
# Sinon, créez directement le compte depuis /register.
INITIAL_USER_USERNAME=
INITIAL_USER_PASSWORD=
SEED_DEMO_DATA=false

# Mission 5
# Ces identifiants configurent l’application SongFest côté serveur.
# L’organisateur se connecte ensuite avec le bouton OAuth ; aucun token utilisateur n’est saisi.
# Callback local à déclarer dans le tableau de bord Spotify :
# http://127.0.0.1:5173/api/spotify/callback
# Générer la clé avec : openssl rand -base64 32
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
SPOTIFY_TOKEN_ENCRYPTION_KEY=

# Mission 9
PLAYBACK_SYNC_INTERVAL_MS=15000
